<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_level_configuration_tree" model="ir.ui.view">
        <field name="name">level.configuration.tree</field>
        <field name="model">level.configuration</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="level_number" />
                <field name="partner_ids" widget="many2many_tags" optional="show" />
                <field name="coin_challenge_time_limit" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <record id="view_level_configuration_form" model="ir.ui.view">
        <field name="name">level.configuration.form</field>
        <field name="model">level.configuration</field>
        <field name="arch" type="xml">
            <form string="Level Configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1><field
                                name="name"
                                placeholder="e.g., Standard Level 1"
                            /></h1>
                    </div>

                    <group>
                        <group string="Basic Configuration">
                            <field name="level_number" />
                            <field
                                name="partner_ids"
                                widget="many2many_tags"
                                domain="[('partner_type', '=', 'patient')]"
                                placeholder="Assign to specific patients (optional)"
                            />
                            <field name="active" />
                        </group>
                        <group string="Timing Configuration">
                            <field name="coin_challenge_time_limit" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field
                                name="description"
                                placeholder="Describe this level configuration..."
                            />
                        </page>

                        <page string="Movement Poses">
                            <group>
                                <group string="Directional Movement">
                                    <field
                                        name="forward_pose_id"
                                        options="{'no_create': True, 'no_edit': True}"
                                    />
                                    <field
                                        name="backward_pose_id"
                                        options="{'no_create': True, 'no_edit': True}"
                                    />
                                </group>
                                <group string="Lateral Movement">
                                    <field
                                        name="left_pose_id"
                                        options="{'no_create': True, 'no_edit': True}"
                                    />
                                    <field
                                        name="right_pose_id"
                                        options="{'no_create': True, 'no_edit': True}"
                                    />
                                </group>
                            </group>
                            <div
                                class="alert alert-warning mt-3"
                                invisible="[('level_number', '!=', 1)]"
                            >
                                <strong
                                >Level 1 Requirement:</strong> All movement poses are required for Level 1.
                            </div>
                        </page>

                        <page string="Coin Poses Configuration">
                            <field name="coin_pose_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" />
                                    <field name="pose_id" />
                                </tree>
                                <form>
                                    <group>
                                        <field name="sequence" />
                                        <field name="pose_id" />
                                    </group>
                                </form>
                            </field>
                            <div class="alert alert-info mt-2">
                                The order of poses selected here will determine the coin sequence (1st pose = Coin 1, 2nd pose = Coin 2, etc.).
                            </div>
                            <div
                                class="alert alert-warning mt-3"
                                invisible="[('level_number', '!=', 1)]"
                            >
                                <strong
                                >Level 1 Requirement:</strong> Exactly 3 coin poses are required for Level 1.
                            </div>
                        </page>

                        <page string="Configuration Summary">
                            <div class="row">
                                <div class="col-md-6">
                                    <h4>Movement Poses:</h4>
                                    <table class="table table-sm">
                                        <tbody>
                                            <tr><td><strong>Forward:</strong></td><td
                                                ><field
                                                        name="forward_pose_id"
                                                        readonly="1"
                                                        nolabel="1"
                                                    /></td></tr>
                                            <tr><td><strong>Backward:</strong></td><td
                                                ><field
                                                        name="backward_pose_id"
                                                        readonly="1"
                                                        nolabel="1"
                                                    /></td></tr>
                                            <tr><td><strong>Left:</strong></td><td
                                                ><field
                                                        name="left_pose_id"
                                                        readonly="1"
                                                        nolabel="1"
                                                    /></td></tr>
                                            <tr><td><strong>Right:</strong></td><td
                                                ><field
                                                        name="right_pose_id"
                                                        readonly="1"
                                                        nolabel="1"
                                                    /></td></tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <h4>Configuration Details:</h4>
                                    <table class="table table-sm">
                                        <tbody>
                                            <tr><td><strong>Level:</strong></td><td
                                                ><field
                                                        name="level_number"
                                                        readonly="1"
                                                        nolabel="1"
                                                    /></td></tr>
                                            <tr>
                                                <td><strong
                                                    >Assigned Patients:</strong></td>
                                                <td>
                                                    <field
                                                        name="partner_ids"
                                                        widget="many2many_tags"
                                                        readonly="1"
                                                        nolabel="1"
                                                        options="{'no_create': True}"
                                                    />
                                                    <span
                                                        class="text-muted"
                                                        invisible="[('partner_ids', '!=', [])]"
                                                    > (Applies to all patients if empty and no other specific config exists)</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td><strong>Coin Poses:</strong></td>
                                                <td>
                                                    <field
                                                        name="coin_pose_line_ids"
                                                        readonly="1"
                                                        nolabel="1"
                                                    >
                                                        <tree>
                                                            <field name="sequence" />
                                                            <field name="pose_id" />
                                                        </tree>
                                                    </field>
                                                </td>
                                            </tr>
                                            <tr><td><strong>Time Limit:</strong></td><td
                                                ><field
                                                        name="coin_challenge_time_limit"
                                                        readonly="1"
                                                        nolabel="1"
                                                    /> seconds</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_level_configuration" model="ir.actions.act_window">
        <field name="name">Level Configurations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">level.configuration</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera configuración de nivel
            </p>
            <p>
                Las configuraciones de nivel te permiten establecer niveles completos del juego con
                asignaciones específicas de poses para movimientos y desafíos de monedas.
                Estas pueden ser genéricas o asignadas a pacientes específicos.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_level_management"
        name="Administration de Niveles"
        parent="clinic_management.clinic_management_menu_root"
        sequence="20"
    />

    <menuitem
        id="menu_level_configurations"
        name="Configuraciones de Niveles"
        parent="menu_level_management"
        action="action_level_configuration"
        sequence="10"
    />
</odoo>
